<UserControl x:Class="VcxDiag.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Functions -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Built-in functions" Style="{StaticResource H2}"/>
                    <WrapPanel>
                        <Button Content="Return all modules to normal" Command="{Binding ReturnToNormalCommand}"
                                ToolTip="Ends any output control or special mode (service $20). Use this if something stays on after a test."/>
                        <Button Content="Send tester present" Command="{Binding TesterPresentCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="My special functions" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" FontSize="12"
                                   Text="Output controls, relearns and resets are specific to each vehicle and module. Save the requests from service information you have access to, and run them here with a safety confirmation."/>
                        <WrapPanel>
                            <Button Content="Edit list…" Command="{Binding EditFunctionsCommand}" Padding="10,5"/>
                            <Button Content="Reload" Command="{Binding ReloadFunctionsCommand}" Padding="10,5"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Run selected…" Command="{Binding RunFunctionCommand}" Style="{StaticResource DangerButton}"/>
                        <Button Content="Stop" Command="{Binding StopFunctionCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" BorderBrush="{StaticResource CardBorder}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource TextMuted}">
                                        <Run Text="{Binding Target, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Request, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Terminal -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Expert terminal" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" FontSize="12"
                               Text="Send any service request and see every reply. Headers, CAN IDs and segmentation are handled for you: type only the service bytes, e.g. 01 0C, 09 02, 1A 90."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"/>
                        <TextBox Grid.Column="2" Text="{Binding CustomAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Optional: type a module address in hex (7E0, 241, 40). Overrides the list."/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="14" Margin="0,0,8,8">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" MinWidth="80"/>
                    </Grid>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                <ListBox ItemsSource="{Binding History}" FontFamily="{StaticResource Mono}" FontSize="13" BorderBrush="{StaticResource CardBorder}"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
