<UserControl x:Class="VcxDiag.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1.  Choose your interface" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                   Text="Plug the VCX Nano into USB and the car's OBD port. Its driver is installed by VX Manager. Pick the demo vehicle to try the app without hardware."/>
                        <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Style="{StaticResource Notice}" Visibility="{Binding InterfaceWarning, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding InterfaceWarning}" TextWrapping="Wrap"/>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Refresh list" Command="{Binding RefreshCommand}"/>
                            <Button Content="Browse for driver DLL…" Command="{Binding BrowseCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2.  Choose the vehicle network" Style="{StaticResource H2}"/>
                        <ComboBox ItemsSource="{Binding Buses}" SelectedItem="{Binding SelectedBus}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="Tip: on 2005-2007 vehicles the engine may be on CAN while body modules are on Class 2 or single wire CAN. Disconnect and pick another network to reach them."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="3.  Connect" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                   Text="Ignition ON. Engine off for codes and module work, running for live data."/>
                        <WrapPanel>
                            <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140" Padding="18,9" FontSize="14"/>
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" MinWidth="120" Padding="18,9"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Interface" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Device" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Column="1" Text="{Binding Shell.DeviceText}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="Firmware" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Firmware}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="Driver" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DllVersion}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="J2534 API" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Api}"/>
                            <TextBlock Grid.Row="4" Text="Battery" Style="{StaticResource Muted}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Shell.BatteryText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="Read" Command="{Binding ReadBatteryCommand}" Padding="10,3" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource H2}"/>
                        <CheckBox Content="US units (°F, mph, psi)" IsChecked="{Binding UsUnits}"/>
                        <CheckBox Content="Write every bus message to the session log" IsChecked="{Binding LogBusTraffic}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11"
                                   Text="Logs, recordings and reports are saved in Documents\VCX Diag."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Muted}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11"
                                   Text="Independent software for J2534 interfaces. Not made by or affiliated with General Motors. Uses public SAE / ISO standards only; manufacturer-specific procedures need the vehicle's service information."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
