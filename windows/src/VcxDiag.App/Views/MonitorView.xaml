<UserControl x:Class="VcxDiag.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Counter}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
                <CheckBox Content="Pause display" IsChecked="{Binding Paused}" Margin="4,0,16,8"/>
                <TextBlock Text="Show only header/ID starting with:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,16,8" FontFamily="{StaticResource Mono}"/>
                <Button Content="Clear" Command="{Binding ClearCommand}"/>
                <Button Content="Save…" Command="{Binding SaveCommand}"/>
            </WrapPanel>
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Frames}" FontFamily="{StaticResource Mono}" RowHeight="22"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time (s)" Binding="{Binding Time}" Width="90"/>
                <DataGridTextColumn Header="Header / ID" Binding="{Binding Header}" Width="110"/>
                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*"/>
                <DataGridTextColumn Header="ASCII" Binding="{Binding Text}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
