<UserControl x:Class="VcxDiag.App.Views.EmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Grid.RowSpan="2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Read freeze frame" Command="{Binding ReadFreezeCommand}" Style="{StaticResource PrimaryButton}"/>
                        <TextBlock Text="Freeze frame" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding FreezeTitle}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding FreezeFrame}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Value name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Reading" Binding="{Binding Value}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Grid.Column="2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Read readiness" Command="{Binding ReadReadinessCommand}" Style="{StaticResource PrimaryButton}"/>
                        <TextBlock Text="Readiness monitors" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ReadinessTitle}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Monitors}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Monitor" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Not complete">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Complete">
                                            <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Not supported">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Grid.Column="2" Grid.Row="1" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Read test results" Command="{Binding ReadTestsCommand}" Style="{StaticResource PrimaryButton}"/>
                        <TextBlock Text="On-board test results (mode $06)" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TestsTitle}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Tests}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Monitor" Binding="{Binding MonitorName}" Width="*"/>
                        <DataGridTextColumn Header="Test" Binding="{Binding Tid, StringFormat='${0:X2}'}" Width="50"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=0.###}" Width="70"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=0.###}" Width="65"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=0.###}" Width="65"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Verdict}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
