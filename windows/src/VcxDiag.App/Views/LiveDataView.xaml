<UserControl x:Class="VcxDiag.App.Views.LiveDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VcxDiag.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Parameter picker -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search values" Margin="0,0,0,6"/>
            <WrapPanel Grid.Row="1">
                <Button Content="Show supported only" Command="{Binding LoadSupportedCommand}" Padding="10,5"/>
                <Button Content="Untick all" Command="{Binding ClearSelectionCommand}" Padding="10,5"/>
            </WrapPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
                <ListBox ItemsSource="{Binding Available}" BorderThickness="0" Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="6,8,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="2,1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                <Button Content="Custom values…" Command="{Binding OpenCustomFileCommand}" Padding="10,5"
                        ToolTip="Edit custom-parameters.json to add your own $22 data identifiers"/>
                <Button Content="Reload" Command="{Binding ReloadCustomCommand}" Padding="10,5"/>
            </WrapPanel>
        </Grid>

        <!-- Values + chart -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Rate}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </StackPanel>
                <WrapPanel>
                    <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" Padding="18,8"/>
                    <Button Content="{Binding RecordText}" Command="{Binding RecordCommand}"/>
                    <Button Content="Reset min/max" Command="{Binding ResetCommand}"/>
                    <TextBlock Text="{Binding RecordInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,8"/>
                </WrapPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Watching}" IsReadOnly="False" FontSize="14" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Graph" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsGraphed, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Value name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="110" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <c:LineChart Series="{Binding Series}" Version="{Binding ChartVersion}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
