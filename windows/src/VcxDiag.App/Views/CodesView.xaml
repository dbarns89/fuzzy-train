<UserControl x:Class="VcxDiag.App.Views.CodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel>
            <Button Content="Read all modules" Command="{Binding ReadAllCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
            <Button Content="Emissions: stored" Command="{Binding ReadStoredCommand}"/>
            <Button Content="Emissions: pending" Command="{Binding ReadPendingCommand}"/>
            <Button Content="Emissions: permanent" Command="{Binding ReadPermanentCommand}"/>
            <Button Content="Clear all codes…" Command="{Binding ClearAllCommand}" Style="{StaticResource DangerButton}" Margin="16,0,8,8"/>
            <Button Content="Copy" Command="{Binding CopyCommand}"/>
            <Button Content="Export CSV…" Command="{Binding ExportCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Codes}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding FullCode}" Width="95" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Failure type" Binding="{Binding FailureTypeText}" Width="190"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="190"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}">
                    <Run Text="{Binding Selected.FullCode, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Selected.Module, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Selected.FailureTypeText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="Status: "/><Run Text="{Binding Selected.StatusText, Mode=OneWay}"/>
                    <Run Text="   Raw status byte: "/><Run Text="{Binding Selected.StatusByte, Mode=OneWay, StringFormat='${0:X2}'}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11"
                           Text="Descriptions are generic SAE meanings. For manufacturer-specific codes, check the service information for this vehicle. Add your own descriptions in Documents\VCX Diag\dtc-descriptions.csv (code,description)."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
