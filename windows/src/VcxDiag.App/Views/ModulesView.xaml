<UserControl x:Class="VcxDiag.App.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel>
            <Button Content="Scan for modules" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" Width="70"/>
                <DataGridTextColumn Header="Diag addr" Binding="{Binding DiagAddress, StringFormat='${0:X2}'}" Width="75"/>
                <DataGridTextColumn Header="Codes" Binding="{Binding DtcCount}" Width="60"/>
                <DataGridTextColumn Header="Found by" Binding="{Binding FoundBy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0,0,0,8"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <WrapPanel>
                <Button Content="Read identification" Command="{Binding IdentifyCommand}"/>
                <Button Content="Read codes" Command="{Binding ReadCodesCommand}"/>
                <Button Content="Clear codes…" Command="{Binding ClearCodesCommand}" Style="{StaticResource DangerButton}"/>
            </WrapPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Identification}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="190"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    <DataGridTextColumn Header="Raw" Binding="{Binding Hex}" Width="*" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Request" Binding="{Binding Id}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="Codes in this module" Style="{StaticResource H2}" Margin="0,12,0,6"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding ModuleCodes}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding FullCode}" Width="90" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
